#!/usr/bin/env bash
#
# agent-box: run a command (default: claude) confined to the project directory.
#
# bwrap with private mount/PID/IPC/UTS/cgroup namespaces. $HOME is a tmpfs; the
# project is the only writable host path. Nix profile links are recreated and
# the daemon socket is passed through (see --no-nix).
#
# Runs as a separate, untrusted uid (box_user in agent-box-mount): The switch
# goes through `sudo agent-box-mount`, which idmaps the needed paths so that
# files the box creates are owned by the invoking user.

set -euo pipefail

die() { printf 'agent-box: %s\n' "$*" >&2; exit 1; }
note() { printf 'agent-box: %s\n' "$*" >&2; }

# ---------------------------------------------------------------- arguments --

# Passed on verbatim by the privilege drop.
orig_args=("$@")

project="$PWD"
project_mode="--bind"
offline=0
share_claude=0
nix_daemon=1
nix_ok=0
dry_run=0
new_session=0
extra_binds=()
extra_rw=()
extra_ro=()
extra_env=()
cmd=()

# Internal: set by the re-exec across sudo. The rest comes from the handoff
# file, which keeps the sudo command line short.
internal_switched=0
internal_home=""
internal_user=""
internal_handoff=""
internal_path=""
internal_profiles=()
internal_env=()

usage() {
    cat <<'USAGE'
Usage: agent-box [options] [--] [command [args...]]

Runs a command confined to the project directory. The default command is
`claude --continue` (plain `claude` if there is no conversation yet), told
via the system prompt that it runs in a sandbox.

Runs as an unprivileged user via `sudo agent-box-mount`, which idmaps the
project and state directory so files the box creates are owned by you.

Options:
  -d, --dir PATH      Project root to confine to (default: current directory)
      --ro            Bind the project read-only instead of read-write
      --offline       Cut off network access (breaks the API; for auditing code)
      --no-nix        Do not pass the Nix daemon socket through
      --share-claude  Bind the real ~/.claude and ~/.claude.json read-write
      --bind PATH     Additionally bind PATH read-write (repeatable)
      --ro-bind PATH  Additionally bind PATH read-only (repeatable)
      --env VAR       Pass environment variable VAR through (repeatable)
      --new           Start a fresh conversation instead of --continue
      --dry-run       Print the command that would run, then exit
  -h, --help          Show this help

Use -- to separate the command from agent-box's own options.

Examples:
  agent-box --ro-bind ~/.gitconfig            # let git commit work
  agent-box -d ~/src/foo -- claude -p 'hi'    # one-shot prompt
  agent-box bash                              # shell inside the sandbox
USAGE
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--dir)      [[ $# -ge 2 ]] || die "--dir needs an argument"
                       project="$2"; shift 2 ;;
        --ro)          project_mode="--ro-bind"; shift ;;
        --offline)     offline=1; shift ;;
        --no-nix)      nix_daemon=0; shift ;;
        --share-claude) share_claude=1; shift ;;
        # Resolved in phase 1 only; phase 2 gets them from the handoff.
        --bind)        [[ $# -ge 2 ]] || die "--bind needs an argument"
                       if [[ $internal_switched -eq 0 ]]; then
                           bind_path="$(realpath -e -- "$2")" || die "no such path: $2"
                           extra_rw+=("$bind_path")
                       fi
                       shift 2 ;;
        --ro-bind)     [[ $# -ge 2 ]] || die "--ro-bind needs an argument"
                       if [[ $internal_switched -eq 0 ]]; then
                           bind_path="$(realpath -e -- "$2")" || die "no such path: $2"
                           extra_ro+=("$bind_path")
                       fi
                       shift 2 ;;
        --env)         [[ $# -ge 2 ]] || die "--env needs an argument"
                       extra_env+=("$2"); shift 2 ;;
        --new)         new_session=1; shift ;;
        --dry-run)     dry_run=1; shift ;;
        -h|--help)     usage; exit 0 ;;
        --internal-switched) internal_switched=1; shift ;;
        --internal-home)     [[ $# -ge 2 ]] || die "--internal-home needs an argument"
                             internal_home="$2"; shift 2 ;;
        --internal-user)     [[ $# -ge 2 ]] || die "--internal-user needs an argument"
                             internal_user="$2"; shift 2 ;;
        --internal-handoff)  [[ $# -ge 2 ]] || die "--internal-handoff needs an argument"
                             internal_handoff="$2"; shift 2 ;;
        --)            shift; cmd=("$@"); break ;;
        -*)            die "unknown option: $1 (use -- to separate the command)" ;;
        *)             cmd=("$@"); break ;;
    esac
done

# Catch the old `agent-box -- -p ...` form.
if [[ ${#cmd[@]} -gt 0 && ${cmd[0]} == -* ]]; then
    die "'${cmd[0]}' is the command to run, not an argument to claude.
             did you mean: agent-box -- claude ${cmd[*]}"
fi

default_cmd=0
if [[ ${#cmd[@]} -eq 0 ]]; then
    cmd=(claude)
    default_cmd=1
elif [[ $new_session -eq 1 ]]; then
    die "--new only applies to the default command, not '${cmd[0]}'"
fi

# Phase 2: sudo has reset the environment. Host paths belong to the invoking
# user, so restore their $HOME.
if [[ $internal_switched -eq 1 ]]; then
    [[ -n "$internal_home" ]] || die "--internal-switched requires --internal-home"
    [[ -n "$internal_user" ]] || die "--internal-switched requires --internal-user"
    [[ -n "$internal_handoff" ]] || die "--internal-switched requires --internal-handoff"
    [[ -f "$internal_handoff" ]] \
        || die "handoff file missing or unreadable by $(id -un): $internal_handoff"
    # It gets sourced (further down), so check its owner. mktemp plus sticky
    # /tmp rule out substitution.
    handoff_uid="$(stat -c %u -- "$internal_handoff")"
    [[ "$handoff_uid" == "$(id -u "$internal_user")" ]] \
        || die "handoff file is not owned by $internal_user: $internal_handoff"

    HOME="$internal_home"; export HOME
fi

# ---------------------------------------------------------------- preflight --

command -v bwrap >/dev/null 2>&1 \
    || die "bubblewrap (bwrap) not found. On NixOS: nix-shell -p bubblewrap"

# Phase 1 only: the box user may not be able to stat the real path.
if [[ $internal_switched -eq 0 ]]; then
    [[ -d "$project" ]] || die "not a directory: $project"
    project="$(realpath -- "$project")"
fi

case "$project" in
    "$HOME"|/|/nix|/nix/*)
        die "refusing to use '$project' as the project root" ;;
esac

# ------------------------------------------------------------------- state --

state_root=""

compute_state_root() {
    local slug hash
    slug="$(printf '%s' "${project#/}" | tr '/' '%')"
    hash="$(printf '%s' "$project" | cksum | cut -d' ' -f1)"
    state_root="${XDG_STATE_HOME:-$HOME/.local/state}/agent-box/${slug}-${hash}"
}

# Phase 1 only. The box user reaches the result through the idmapped mount.
ensure_state_root() {
    [[ -d "$state_root" ]] && return 0

    mkdir -p "$state_root/claude"
    chmod 700 "$state_root" "$state_root/claude"

    # Seed from the host config minus `projects` and `githubRepoPaths`, which
    # leak other work. The rest avoids re-onboarding.
    local seeded=0
    if [[ -f "$HOME/.claude.json" ]]; then
        if command -v python3 >/dev/null 2>&1; then
            python3 - "$HOME/.claude.json" "$state_root/claude.json" <<'PY' && seeded=1
import json, sys
try:
    with open(sys.argv[1]) as fh:
        cfg = json.load(fh)
except Exception:
    sys.exit(1)
for key in ("projects", "githubRepoPaths"):
    cfg.pop(key, None)
with open(sys.argv[2], "w") as fh:
    json.dump(cfg, fh)
PY
        elif command -v jq >/dev/null 2>&1; then
            jq 'del(.projects, .githubRepoPaths)' \
               < "$HOME/.claude.json" > "$state_root/claude.json" && seeded=1
        fi
    fi
    [[ $seeded -eq 1 ]] || printf '{}' > "$state_root/claude.json"
    chmod 600 "$state_root/claude.json"

    [[ -f "$HOME/.claude/settings.json" ]] \
        && cp "$HOME/.claude/settings.json" "$state_root/claude/settings.json"
    return 0
}

# ------------------------------------------------------------------- access --

# binds: mode/path pairs. shares: the subset owned by the invoking user, which
# agent-box-mount idmaps. Other paths are bound as is and must be reachable by
# the box user.
binds=()
shares=()

build_binds() {
    binds=()
    shares=()
    local p i

    if [[ $project_mode == --ro-bind ]]; then
        binds+=(ro "$project")
    else
        binds+=(rw "$project")
    fi

    if [[ $share_claude -eq 1 ]]; then
        binds+=(rw "$HOME/.claude")
        [[ -f "$HOME/.claude.json" ]] && binds+=(rw "$HOME/.claude.json")
    else
        binds+=(rw "$state_root")
        [[ -f "$HOME/.claude/.credentials.json" ]] \
            && binds+=(rw "$HOME/.claude/.credentials.json")
    fi

    for p in "${extra_rw[@]}"; do binds+=(rw "$p"); done
    for p in "${extra_ro[@]}"; do binds+=(ro "$p"); done

    for ((i = 0; i < ${#binds[@]}; i += 2)); do
        p="${binds[i+1]}"
        [[ -e "$p" ]] || die "no such file or directory: $p"
        [[ "$(stat -c %u -- "$p")" == "$(id -u)" ]] && shares+=("${binds[i]}" "$p")
    done
    return 0
}

# Phase 2: bind source per host path. agent-box-mount stages the shares, in
# order, as $AGENT_BOX_STAGE/0, /1, ...
declare -A bind_src=()

resolve_sources() {
    local i
    if [[ ${#shares[@]} -gt 0 ]]; then
        [[ -n "${AGENT_BOX_STAGE:-}" ]] \
            || die "AGENT_BOX_STAGE is not set — phase 2 must be started by agent-box-mount"
        for ((i = 0; i < ${#shares[@]}; i += 2)); do
            bind_src[${shares[i+1]}]="$AGENT_BOX_STAGE/$((i / 2))"
        done
    fi
}

src_of() { printf '%s' "${bind_src[$1]:-$1}"; }

# Runs as the box user, so the kernel decides.
check_access() {
    local -a bad=()
    local i mode p src

    for ((i = 0; i < ${#binds[@]}; i += 2)); do
        mode="${binds[i]}"
        p="${binds[i+1]}"
        src="$(src_of "$p")"
        if [[ -d "$src" ]]; then
            [[ -r "$src" && -x "$src" ]] || bad+=("$p")
        else
            [[ -r "$src" ]] || bad+=("$p")
        fi
        [[ $mode == ro || -w "$src" ]] || bad+=("$p (read-write)")
    done
    [[ ${#bad[@]} -eq 0 ]] && return 0

    {
        printf 'agent-box: running as %s (uid %s), which cannot reach:\n' \
            "$(id -un)" "$(id -u)"
        printf '  %s\n' "${bad[@]}"
        printf '\nPaths you own are idmapped and always reachable; these are not yours,\n'
        printf 'so the box user needs access to them on its own permissions.\n'
    } >&2
    exit 1
}

# ----------------------------------------------------------------- handoff --

if [[ $internal_switched -eq 1 ]]; then
    # shellcheck source=/dev/null
    . "$internal_handoff"
    # shellcheck disable=SC2163  # each entry is NAME=value, which export takes
    for kv in "${internal_env[@]}"; do export "$kv"; done
fi

# ----------------------------------------------------------- privilege drop --

# Phase 1, as the invoking user: resolve paths, set up state, decide binds, then
# re-exec as the box user through agent-box-mount with --internal-switched
# (phase 2, which builds the sandbox).
#
# This can't happen inside bwrap: capabilities are dropped there, and --uid
# doesn't change the uid the Nix daemon sees via SO_PEERCRED.
if [[ $internal_switched -eq 0 ]]; then
    command -v sudo >/dev/null 2>&1 \
        || die "sudo not found — it is how agent-box drops to the box user"

    # The wrapper, not the script: it restores PATH after sudo resets it.
    self="${AGENT_BOX_SELF:-$(realpath -- "$0")}"
    mount_helper="${AGENT_BOX_MOUNT:-$(dirname -- "$self")/agent-box-mount}"
    [[ -x "$mount_helper" ]] || die "agent-box-mount not found at $mount_helper"

    if [[ $share_claude -eq 0 ]]; then
        compute_state_root
        ensure_state_root
    fi

    build_binds

    # Handoff to phase 2. Not argv (keeps the sudo line readable), not the
    # environment (sudo resets it). Holds no secrets, so it can be
    # world-readable. /tmp, not $TMPDIR, which may be private.
    handoff="$(mktemp /tmp/agent-box-handoff.XXXXXXXX)"
    trap 'rm -f -- "$handoff"' EXIT INT TERM
    chmod 644 -- "$handoff"
    {
        printf '# agent-box: handed to the box user for this run; safe to delete.\n'
        printf 'project=%q\n' "$project"
        printf 'project_mode=%q\n' "$project_mode"
        printf 'state_root=%q\n' "$state_root"
        printf 'internal_path=%q\n' "$PATH"
        # Resolved here: the chains run through directories the box user can't
        # read.
        for link in \
            "$HOME/.nix-profile" \
            "$HOME/.local/state/nix/profile" \
            "$HOME/.local/state/nix/profiles/profile" \
            /nix/var/nix/profiles/default
        do
            [[ -e "$link" ]] || continue
            target="$(readlink -f -- "$link" 2>/dev/null)" || continue
            case "$target" in
                /nix/store/*) printf 'internal_profiles+=(%q %q)\n' "$link" "$target" ;;
            esac
        done
        # Non-secret only; ANTHROPIC_API_KEY/AUTH_TOKEN stay behind.
        for var in TERM COLORTERM TERM_PROGRAM SHELL LANG LC_ALL LC_CTYPE TZ \
                   SSL_CERT_FILE NIX_SSL_CERT_FILE NIX_REMOTE NIX_PATH NIX_CONFIG \
                   ANTHROPIC_BASE_URL ANTHROPIC_MODEL \
                   CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX
        do
            [[ -n "${!var:-}" ]] && printf 'internal_env+=(%q)\n' "$var=${!var}"
        done
        # shares must keep the order agent-box-mount receives them in.
        for pathspec in "${extra_rw[@]}"; do printf 'extra_rw+=(%q)\n' "$pathspec"; done
        for pathspec in "${extra_ro[@]}"; do printf 'extra_ro+=(%q)\n' "$pathspec"; done
        for pathspec in "${binds[@]}"; do printf 'binds+=(%q)\n' "$pathspec"; done
        for pathspec in "${shares[@]}"; do printf 'shares+=(%q)\n' "$pathspec"; done
    } > "$handoff"

    for var in ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN "${extra_env[@]}"; do
        [[ -n "${!var:-}" ]] \
            && note "$var is not carried across the switch to the box user; the box uses its own login"
    done

    sudo_cmd=(sudo -- "$mount_helper" "${shares[@]}" --
              "$self" --internal-switched
              --internal-user "$(id -un)"
              --internal-home "$HOME"
              --internal-handoff "$handoff"
              "${orig_args[@]}")

    note "Switching to box user"
    { printf 'agent-box: +'; printf ' %q' "${sudo_cmd[@]}"; printf '\n'; } >&2

    # Stop at the switch and keep the handoff, so the printed line can be run.
    if [[ $dry_run -eq 1 ]]; then
        trap - EXIT INT TERM
        note "handoff kept for that command: $handoff"
        exit 0
    fi

    # Not exec: the trap removes the handoff afterwards.
    rc=0
    "${sudo_cmd[@]}" || rc=$?
    exit $rc
fi

# Phase 2, as the box user, inside agent-box-mount's mount namespace.
resolve_sources
check_access

# ------------------------------------------------------- nix path discovery --

nix_args=()

[[ -d /nix/store ]] || die "/nix/store not found — is this a Nix system?"
nix_args+=(--ro-bind /nix/store /nix/store)

# The daemon builds outside the sandbox; only its socket is needed. /nix/var is
# ro (NIX_PATH channels), the socket dir rw on top. A ro bind wouldn't stop
# connect() anyway; the connection is untrusted because of our uid.
#
# Off with --offline: the daemon would fetch on our behalf.
[[ $offline -eq 1 ]] && nix_daemon=0

if [[ $nix_daemon -eq 1 && -S /nix/var/nix/daemon-socket/socket ]]; then
    nix_ok=1
    nix_args+=(--ro-bind /nix/var /nix/var)
    nix_args+=(--bind /nix/var/nix/daemon-socket /nix/var/nix/daemon-socket)
    [[ -w /nix/var/nix/daemon-socket/socket ]] \
        || note "the Nix daemon socket is not writable by $(id -un); nix will not work inside"
fi

# NixOS runtime paths, if present.
for p in /run/current-system /run/wrappers /run/opengl-driver /run/opengl-driver-32; do
    [[ -e "$p" ]] && nix_args+=(--ro-bind-try "$p" "$p")
done

# Profile links like ~/.nix-profile, erased by the tmpfs $HOME. Recreated as
# symlinks to their store paths, after the tmpfs.
profile_args=()
profile_links=()
if [[ ${#internal_profiles[@]} -gt 0 ]]; then
    profile_links=("${internal_profiles[@]}")
else
    for link in \
        "$HOME/.nix-profile" \
        "$HOME/.local/state/nix/profile" \
        "$HOME/.local/state/nix/profiles/profile" \
        /nix/var/nix/profiles/default
    do
        [[ -e "$link" ]] || continue
        target="$(readlink -f -- "$link" 2>/dev/null)" || continue
        case "$target" in
            /nix/store/*) profile_links+=("$link" "$target") ;;
        esac
    done
fi
while [[ ${#profile_links[@]} -gt 0 ]]; do
    link="${profile_links[0]}"
    target="${profile_links[1]}"
    profile_links=("${profile_links[@]:2}")
    # Already there via the /nix/var bind; --symlink would fail with EEXIST.
    [[ $nix_ok -eq 1 && "$link" == /nix/var/* ]] && continue
    profile_args+=(--symlink "$target" "$link")
done
# /etc/profiles/per-user resolves through the /etc bind.

# /etc/static, certs, nsswitch, DNS. Root-only secrets stay unreadable to us.
nix_args+=(--ro-bind /etc /etc)

# ------------------------------------------------------ isolated claude state --

state_args=()

# The box user can't see the real paths, so check the bind list.
has_bind() {
    local i
    for ((i = 1; i < ${#binds[@]}; i += 2)); do
        [[ "${binds[i]}" == "$1" ]] && return 0
    done
    return 1
}

if [[ $share_claude -eq 1 ]]; then
    state_args+=(--bind "$(src_of "$HOME/.claude")" "$HOME/.claude")
    has_bind "$HOME/.claude.json" \
        && state_args+=(--bind "$(src_of "$HOME/.claude.json")" "$HOME/.claude.json")
else
    state_src="$(src_of "$state_root")"
    state_args+=(--bind "$state_src/claude" "$HOME/.claude")
    state_args+=(--bind "$state_src/claude.json" "$HOME/.claude.json")

    # Shared, not copied: a copy's OAuth token rotation would log out the host.
    creds="$HOME/.claude/.credentials.json"
    has_bind "$creds" && state_args+=(--bind "$(src_of "$creds")" "$creds")
fi

for p in "${extra_rw[@]}"; do extra_binds+=(--bind "$(src_of "$p")" "$p"); done
for p in "${extra_ro[@]}"; do extra_binds+=(--ro-bind "$(src_of "$p")" "$p"); done

# --continue fails without a transcript. Claude names the transcript dir after
# the project path with non-alphanumerics replaced by '-'.
if [[ $default_cmd -eq 1 && $new_session -eq 0 ]]; then
    if [[ $share_claude -eq 1 ]]; then
        claude_dir="$(src_of "$HOME/.claude")"
    else
        claude_dir="$(src_of "$state_root")/claude"
    fi
    transcripts="$claude_dir/projects/${project//[^a-zA-Z0-9]/-}"
    # Not compgen: Nix's non-interactive bash lacks it. An unmatched glob stays
    # literal and fails -e.
    transcript_files=("$transcripts"/*.jsonl)
    if [[ -e ${transcript_files[0]} ]]; then
        cmd+=(--continue)
    fi
fi

# Otherwise claude takes missing tools or an empty $HOME as facts about the
# machine and tries to fix them.
if [[ $default_cmd -eq 1 ]]; then
    cmd+=(--append-system-prompt "You are running inside a restricted \
sandbox. Do not make assumptions about the project based on the environment. \
Do not read user data or run search queries outside the project folder. \
$HOME is a tmpfs, you can write there (within reason), but all data will be lost.\
If you need to keep data between sessions, store it in the project folder under .agents. \
Do not try to work around the sandbox, instead, ask the user")
fi

# -------------------------------------------------------------- environment --

# sudo resets PATH; phase 2 gets the host's from the handoff.
host_path="${internal_path:-$PATH}"

# Drop $HOME entries, except the recreated Nix profiles.
sandbox_path=""
while IFS= read -r entry; do
    [[ -z "$entry" ]] && continue
    case "$entry" in
        "$HOME"/.nix-profile/*|"$HOME"/.local/state/nix/profile/*) ;;
        "$HOME"/*) continue ;;
    esac
    sandbox_path="${sandbox_path:+$sandbox_path:}$entry"
done < <(printf '%s' "$host_path" | tr ':' '\n')

# Clearer than bwrap's execvp error.
if [[ ${cmd[0]} != */* ]]; then
    ( PATH="$sandbox_path"; hash -r; command -v -- "${cmd[0]}" ) >/dev/null 2>&1 \
        || die "command not found on the sandbox PATH: ${cmd[0]}"
fi

box_user_name="$(id -un)"

env_args=(--clearenv)
env_args+=(--setenv HOME "$HOME")
env_args+=(--setenv USER "$box_user_name")
env_args+=(--setenv LOGNAME "$box_user_name")
env_args+=(--setenv PATH "$sandbox_path")
env_args+=(--setenv PWD "$project")

# For projects not owned by the user, which aren't idmapped: git would refuse
# them as "dubious ownership".
env_args+=(--setenv GIT_CONFIG_COUNT 1)
env_args+=(--setenv GIT_CONFIG_KEY_0 safe.directory)
env_args+=(--setenv GIT_CONFIG_VALUE_0 "$project")

nix_env=()
[[ $nix_ok -eq 1 ]] && nix_env=(NIX_REMOTE NIX_PATH)

# Allowlist, so unrelated secrets (AWS_*, GITHUB_TOKEN, ...) stay out.
for var in SHELL TERM COLORTERM TERM_PROGRAM LANG LC_ALL LC_CTYPE TZ \
           SSL_CERT_FILE NIX_SSL_CERT_FILE "${nix_env[@]}" \
           ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL \
           ANTHROPIC_MODEL CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX \
           "${extra_env[@]}"
do
    [[ -n "${!var:-}" ]] && env_args+=(--setenv "$var" "${!var}")
done

# nix.conf often holds access-tokens, so it isn't bound; it's passed as
# NIX_CONFIG with secret settings removed. In phase 2 NIX_CONFIG arrives
# already scrubbed.
if [[ $nix_ok -eq 1 ]]; then
    nix_config="${NIX_CONFIG:-}"
    if [[ $internal_switched -eq 0 && -r "$HOME/.config/nix/nix.conf" ]]; then
        scrubbed="$(grep -Ev \
            '^[[:space:]]*(extra-)?(access-tokens|netrc-file|secret-key-files)[[:space:]]*=' \
            "$HOME/.config/nix/nix.conf" || true)"
        if [[ -n "$nix_config" ]]; then
            nix_config="$(printf '%s\n%s' "$nix_config" "$scrubbed")"
        else
            nix_config="$scrubbed"
        fi
    fi
    [[ -n "${nix_config//[[:space:]]/}" ]] \
        && env_args+=(--setenv NIX_CONFIG "$nix_config")
fi

# ----------------------------------------------------------- sandbox launch --

# Verify the daemon doesn't trust us. Best-effort: older nix may not answer.
if [[ $nix_ok -eq 1 ]] && command -v nix >/dev/null 2>&1; then
    trusted="$(nix store info --json --extra-experimental-features nix-command \
                 2>/dev/null | tr -d '[:space:]' | grep -o '"trusted":[a-z0-9]*' || true)"
    case "$trusted" in
        '"trusted":true'|'"trusted":1')
            die "the Nix daemon still trusts this uid ($box_user_name): it is listed in trusted-users (nix.conf), so the sandbox would be able to set build-hook and friends. Set a different box_user in agent-box-mount." ;;
    esac
fi

bwrap_args=(
    "${nix_args[@]}"
    --proc /proc
    --dev /dev
    --tmpfs "$HOME"          # before any bind under $HOME
    "${profile_args[@]}"
    --tmpfs /tmp
    --tmpfs /var/tmp
    "$project_mode" "$(src_of "$project")" "$project"
    "${state_args[@]}"
    "${extra_binds[@]}"
    --unshare-pid
    --unshare-ipc
    --unshare-uts
    --unshare-cgroup
    --hostname agent-box
    --cap-drop ALL
    --die-with-parent
    --chdir "$project"
    "${env_args[@]}"
)

# No --unshare-user: breaks Claude Code's nested bwrap. No --new-session: the
# UI needs the controlling TTY, and TIOCSTI is off on modern kernels anyway.
[[ $offline -eq 1 ]] && bwrap_args+=(--unshare-net)

if [[ $dry_run -eq 1 ]]; then
    printf 'bwrap'
    printf ' %q' "${bwrap_args[@]}" -- "${cmd[@]}"
    printf '\n'
    exit 0
fi

exec bwrap "${bwrap_args[@]}" -- "${cmd[@]}"

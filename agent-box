#!/usr/bin/env bash
#
# agent-box — run a command (Claude Code by default) confined to the current
# project directory.
#
# Uses bubblewrap (user namespaces) to give the command a private mount, PID,
# IPC, UTS and cgroup namespace. The project directory is the only writable
# path outside the sandbox's own tmpfs; $HOME is replaced by a tmpfs so other
# projects, SSH keys and shell history are simply not there.
#
# The command defaults to `claude`, but any command can be given instead, which
# is the easy way to inspect what the sandbox actually looks like from inside.
#
# Nix-aware: resolves the Nix profile chain to its store path and recreates it
# as a symlink inside the sandbox, so the toolchain on $PATH keeps working
# without binding anything under the real $HOME. The Nix daemon socket is passed
# through as well, so builds work inside; see --no-nix.
#
# The sandbox runs as a separate unprivileged user (set in agent-box-mount).
# The Nix daemon decides client trust from the peer's uid and a user namespace
# cannot change that, so a sandbox running as a trusted user could set
# build-hook, post-build-hook, extra-sandbox-paths or substituters on the
# daemon — which is root-equivalent in practice. Running as an untrusted uid
# removes that, and the invoking user's own files become unreachable by plain
# file permissions rather than by bwrap's binds alone. The switch goes through
# `sudo agent-box-mount` and is printed before it runs. That small fixed helper
# gives the box the few paths it needs through idmapped mounts: the box sees
# them as its own, and what it creates there lands on disk as the invoking
# user's.

set -euo pipefail

die() { printf 'agent-box: %s\n' "$*" >&2; exit 1; }
note() { printf 'agent-box: %s\n' "$*" >&2; }

# ---------------------------------------------------------------- arguments --

# Kept verbatim: the privilege drop re-execs this same script with them.
orig_args=("$@")

project="$PWD"
project_mode="--bind"
offline=0
share_claude=0
nix_daemon=1
nix_ok=0
dry_run=0
new_session=0
extra_binds=()
extra_rw=()
extra_ro=()
extra_env=()
cmd=()

# Set by the re-exec; see "privilege drop". Undocumented on purpose: they are
# this script talking to itself across sudo, not a user interface. The bulk
# travels in a handoff file rather than argv, so the sudo command line stays
# short enough to actually read before it runs.
internal_switched=0
internal_home=""
internal_user=""
internal_handoff=""
internal_path=""
internal_profiles=()
internal_env=()

usage() {
    cat <<'USAGE'
Usage: agent-box [options] [--] [command [args...]]

Runs a command confined to the project directory. The command defaults to
`claude --continue`, resuming the project's last conversation (plain
`claude` if there is none yet), with a system-prompt note that it runs in
a sandbox; give another one to inspect or test the
sandbox from inside.

The sandbox runs as an unprivileged user (set in agent-box-mount) so that
its Nix daemon connection is untrusted. The switch goes through
`sudo agent-box-mount`, which also hands the box the project and its state
directory through idmapped mounts: files the box creates are owned by you.

Options:
  -d, --dir PATH      Project root to confine to (default: current directory)
      --ro            Bind the project read-only instead of read-write
      --offline       Cut off network access (breaks the API; for auditing code)
      --no-nix        Do not pass the Nix daemon socket through
      --share-claude  Bind the real ~/.claude and ~/.claude.json read-write
      --bind PATH     Additionally bind PATH read-write (repeatable)
      --ro-bind PATH  Additionally bind PATH read-only (repeatable)
      --env VAR       Pass environment variable VAR through (repeatable)
      --new           Start a fresh conversation instead of --continue
      --dry-run       Print the command that would run, then exit
  -h, --help          Show this help

Use -- to separate the command from agent-box's own options.

Examples:
  agent-box                                   # confine to $PWD, resume claude
  agent-box --new                             # ...or start a new conversation
  agent-box --ro-bind ~/.gitconfig            # let git commit work
  agent-box -d ~/src/foo -- claude -p 'hi'    # one-shot prompt
  agent-box bash                              # poke around inside the sandbox
  agent-box -- env                            # see the scrubbed environment
  agent-box --offline -- ls -la /             # what the filesystem looks like
USAGE
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--dir)      [[ $# -ge 2 ]] || die "--dir needs an argument"
                       project="$2"; shift 2 ;;
        --ro)          project_mode="--ro-bind"; shift ;;
        --offline)     offline=1; shift ;;
        --no-nix)      nix_daemon=0; shift ;;
        --share-claude) share_claude=1; shift ;;
        # Resolved by phase 1 only; phase 2 gets them from the handoff, as
        # the box user may not be able to resolve them at all.
        --bind)        [[ $# -ge 2 ]] || die "--bind needs an argument"
                       if [[ $internal_switched -eq 0 ]]; then
                           bind_path="$(realpath -e -- "$2")" || die "no such path: $2"
                           extra_rw+=("$bind_path")
                       fi
                       shift 2 ;;
        --ro-bind)     [[ $# -ge 2 ]] || die "--ro-bind needs an argument"
                       if [[ $internal_switched -eq 0 ]]; then
                           bind_path="$(realpath -e -- "$2")" || die "no such path: $2"
                           extra_ro+=("$bind_path")
                       fi
                       shift 2 ;;
        --env)         [[ $# -ge 2 ]] || die "--env needs an argument"
                       extra_env+=("$2"); shift 2 ;;
        --new)         new_session=1; shift ;;
        --dry-run)     dry_run=1; shift ;;
        -h|--help)     usage; exit 0 ;;
        --internal-switched) internal_switched=1; shift ;;
        --internal-home)     [[ $# -ge 2 ]] || die "--internal-home needs an argument"
                             internal_home="$2"; shift 2 ;;
        --internal-user)     [[ $# -ge 2 ]] || die "--internal-user needs an argument"
                             internal_user="$2"; shift 2 ;;
        --internal-handoff)  [[ $# -ge 2 ]] || die "--internal-handoff needs an argument"
                             internal_handoff="$2"; shift 2 ;;
        --)            shift; cmd=("$@"); break ;;
        -*)            die "unknown option: $1 (use -- to separate the command)" ;;
        *)             cmd=("$@"); break ;;
    esac
done

# Everything after -- used to be claude's arguments; it is now the command
# itself. Catch the old form rather than failing with a bare execvp error.
if [[ ${#cmd[@]} -gt 0 && ${cmd[0]} == -* ]]; then
    die "'${cmd[0]}' is the command to run, not an argument to claude.
             did you mean: agent-box -- claude ${cmd[*]}"
fi

# Only the default command gets --continue; an explicit one runs verbatim.
default_cmd=0
if [[ ${#cmd[@]} -eq 0 ]]; then
    cmd=(claude)
    default_cmd=1
elif [[ $new_session -eq 1 ]]; then
    die "--new only applies to the default command, not '${cmd[0]}'"
fi

# On the far side of the switch, $HOME is the box user's and sudo has reset the
# environment. Everything phase 1 worked out is read back here: the host paths
# all belong to the invoking user, so put their $HOME back and keep using it.
if [[ $internal_switched -eq 1 ]]; then
    [[ -n "$internal_home" ]] || die "--internal-switched requires --internal-home"
    [[ -n "$internal_user" ]] || die "--internal-switched requires --internal-user"
    [[ -n "$internal_handoff" ]] || die "--internal-switched requires --internal-handoff"
    [[ -f "$internal_handoff" ]] \
        || die "handoff file missing or unreadable by $(id -un): $internal_handoff"
    # It gets sourced, so insist it belongs to the user who claims to have
    # written it. mktemp created it under a unique name with mode 0644, and /tmp
    # is sticky, so nobody else can have substituted or rewritten it. Reading it
    # waits until every variable it sets has been declared, further down.
    handoff_uid="$(stat -c %u -- "$internal_handoff")"
    [[ "$handoff_uid" == "$(id -u "$internal_user")" ]] \
        || die "handoff file is not owned by $internal_user: $internal_handoff"

    HOME="$internal_home"; export HOME
fi

# ---------------------------------------------------------------- preflight --

command -v bwrap >/dev/null 2>&1 \
    || die "bubblewrap (bwrap) not found. On NixOS: nix-shell -p bubblewrap"

# Phase 1 resolved and validated the project; the box user may not even be
# able to stat its real path, only the idmapped copy.
if [[ $internal_switched -eq 0 ]]; then
    [[ -d "$project" ]] || die "not a directory: $project"
    project="$(realpath -- "$project")"
fi

# Confining to $HOME or / would defeat the purpose; fail loudly rather than
# pretend to sandbox.
case "$project" in
    "$HOME"|/|/nix|/nix/*)
        die "refusing to use '$project' as the project root" ;;
esac

# ------------------------------------------------------------------- state --

state_root=""

compute_state_root() {
    local slug hash
    slug="$(printf '%s' "${project#/}" | tr '/' '%')"
    hash="$(printf '%s' "$project" | cksum | cut -d' ' -f1)"
    state_root="${XDG_STATE_HOME:-$HOME/.local/state}/agent-box/${slug}-${hash}"
}

# Runs as the invoking user only: the box user has no business being able to
# create directories under their $HOME. It reaches the result through the
# idmapped mount, where these 0700/0600 modes read as its own.
ensure_state_root() {
    [[ -d "$state_root" ]] && return 0

    mkdir -p "$state_root/claude"
    chmod 700 "$state_root" "$state_root/claude"

    # Seed .claude.json from the host config minus the per-project history.
    # Carrying the rest over preserves onboarding state, so a new project
    # does not re-prompt for theme/trust; `projects` and `githubRepoPaths`
    # are the fields that actually leak other work.
    local seeded=0
    if [[ -f "$HOME/.claude.json" ]]; then
        if command -v python3 >/dev/null 2>&1; then
            python3 - "$HOME/.claude.json" "$state_root/claude.json" <<'PY' && seeded=1
import json, sys
try:
    with open(sys.argv[1]) as fh:
        cfg = json.load(fh)
except Exception:
    sys.exit(1)
for key in ("projects", "githubRepoPaths"):
    cfg.pop(key, None)
with open(sys.argv[2], "w") as fh:
    json.dump(cfg, fh)
PY
        elif command -v jq >/dev/null 2>&1; then
            jq 'del(.projects, .githubRepoPaths)' \
               < "$HOME/.claude.json" > "$state_root/claude.json" && seeded=1
        fi
    fi
    [[ $seeded -eq 1 ]] || printf '{}' > "$state_root/claude.json"
    chmod 600 "$state_root/claude.json"

    [[ -f "$HOME/.claude/settings.json" ]] \
        && cp "$HOME/.claude/settings.json" "$state_root/claude/settings.json"
    return 0
}

# ------------------------------------------------------------------- access --

# The host paths the sandbox binds, as mode/path pairs. Those owned by the
# invoking user — normally all of them — are handed to agent-box-mount, which
# presents them idmapped so that the box works on them as their owner. Anything
# else (a --ro-bind of a system file, say) is bound as it is and has to be
# reachable by the box user on its own permissions.
binds=()
shares=()

build_binds() {
    binds=()
    shares=()
    local p i

    if [[ $project_mode == --ro-bind ]]; then
        binds+=(ro "$project")
    else
        binds+=(rw "$project")
    fi

    if [[ $share_claude -eq 1 ]]; then
        binds+=(rw "$HOME/.claude")
        [[ -f "$HOME/.claude.json" ]] && binds+=(rw "$HOME/.claude.json")
    else
        binds+=(rw "$state_root")
        # Bound read-write into the sandbox so box and host keep the same OAuth
        # refresh token (see the bind below).
        [[ -f "$HOME/.claude/.credentials.json" ]] \
            && binds+=(rw "$HOME/.claude/.credentials.json")
    fi

    for p in "${extra_rw[@]}"; do binds+=(rw "$p"); done
    for p in "${extra_ro[@]}"; do binds+=(ro "$p"); done

    for ((i = 0; i < ${#binds[@]}; i += 2)); do
        p="${binds[i+1]}"
        [[ -e "$p" ]] || die "no such file or directory: $p"
        [[ "$(stat -c %u -- "$p")" == "$(id -u)" ]] && shares+=("${binds[i]}" "$p")
    done
    return 0
}

# Phase 2: where each host path is bound from. agent-box-mount stages the
# shares, in the order given, as $AGENT_BOX_STAGE/0, /1, ...
declare -A bind_src=()

resolve_sources() {
    local i
    if [[ ${#shares[@]} -gt 0 ]]; then
        [[ -n "${AGENT_BOX_STAGE:-}" ]] \
            || die "AGENT_BOX_STAGE is not set — phase 2 must be started by agent-box-mount"
        for ((i = 0; i < ${#shares[@]}; i += 2)); do
            bind_src[${shares[i+1]}]="$AGENT_BOX_STAGE/$((i / 2))"
        done
    fi
}

src_of() { printf '%s' "${bind_src[$1]:-$1}"; }

# Run as the box user, so the kernel is the one answering.
check_access() {
    local -a bad=()
    local i mode p src

    for ((i = 0; i < ${#binds[@]}; i += 2)); do
        mode="${binds[i]}"
        p="${binds[i+1]}"
        src="$(src_of "$p")"
        if [[ -d "$src" ]]; then
            [[ -r "$src" && -x "$src" ]] || bad+=("$p")
        else
            [[ -r "$src" ]] || bad+=("$p")
        fi
        [[ $mode == ro || -w "$src" ]] || bad+=("$p (read-write)")
    done
    [[ ${#bad[@]} -eq 0 ]] && return 0

    {
        printf 'agent-box: running as %s (uid %s), which cannot reach:\n' \
            "$(id -un)" "$(id -u)"
        printf '  %s\n' "${bad[@]}"
        printf '\nPaths you own are idmapped and always reachable; these are not yours,\n'
        printf 'so the box user needs access to them on its own permissions.\n'
    } >&2
    exit 1
}

# ----------------------------------------------------------------- handoff --

# Now that everything it sets has been declared, read what phase 1 worked out:
# the project, the state directory, the host $PATH, the resolved profile links,
# the environment worth carrying, and the bind lists.
if [[ $internal_switched -eq 1 ]]; then
    # shellcheck source=/dev/null
    . "$internal_handoff"
    # shellcheck disable=SC2163  # each entry is NAME=value, which export takes
    for kv in "${internal_env[@]}"; do export "$kv"; done
fi

# ----------------------------------------------------------- privilege drop --

# Phase 1, still the invoking user: do everything that has to be done as them —
# resolving symlink chains through 0700 directories, creating and seeding the
# state directory, deciding what gets bound — then re-exec as the box user
# through agent-box-mount. Phase 2 is this same script with
# --internal-switched, and is where the sandbox gets built.
#
# The switch must happen out here: inside bwrap all capabilities are dropped,
# and bwrap's --uid only relabels the uid within its own namespace, which is not
# what the Nix daemon sees over SO_PEERCRED.
if [[ $internal_switched -eq 0 ]]; then
    command -v sudo >/dev/null 2>&1 \
        || die "sudo not found — it is how agent-box drops to the box user"

    # The wrapper, not the wrapped script: it is what puts bubblewrap and the
    # toolchain back on $PATH after the environment has been reset.
    self="${AGENT_BOX_SELF:-$(realpath -- "$0")}"
    mount_helper="${AGENT_BOX_MOUNT:-$(dirname -- "$self")/agent-box-mount}"
    [[ -x "$mount_helper" ]] || die "agent-box-mount not found at $mount_helper"

    if [[ $share_claude -eq 0 ]]; then
        compute_state_root
        ensure_state_root
    fi

    build_binds

    # The handoff. Everything phase 2 needs to rebuild what was worked out here,
    # kept out of argv so the printed sudo line stays readable — and out of the
    # environment, which sudo resets unless the sudoers rule says SETENV. It
    # holds paths, $PATH and the scrubbed NIX_CONFIG; no secrets, which is why
    # it can be world readable, as the box user has to read it.
    # /tmp explicitly, not $TMPDIR: the box user has to be able to read this,
    # and a per-session TMPDIR is routinely private to its owner.
    handoff="$(mktemp /tmp/agent-box-handoff.XXXXXXXX)"
    trap 'rm -f -- "$handoff"' EXIT INT TERM
    chmod 644 -- "$handoff"
    {
        printf '# agent-box: handed to the box user for this run; safe to delete.\n'
        printf 'project=%q\n' "$project"
        printf 'project_mode=%q\n' "$project_mode"
        printf 'state_root=%q\n' "$state_root"
        printf 'internal_path=%q\n' "$PATH"
        # Resolved here because the chain runs through directories the box user
        # has no business reading (~/.local/state is 0700 on a stock install).
        for link in \
            "$HOME/.nix-profile" \
            "$HOME/.local/state/nix/profile" \
            "$HOME/.local/state/nix/profiles/profile" \
            /nix/var/nix/profiles/default
        do
            [[ -e "$link" ]] || continue
            target="$(readlink -f -- "$link" 2>/dev/null)" || continue
            case "$target" in
                /nix/store/*) printf 'internal_profiles+=(%q %q)\n' "$link" "$target" ;;
            esac
        done
        # Non-secret environment the sandbox would otherwise lose. The
        # ANTHROPIC_* secrets are deliberately not among them: a world-readable
        # file is no place for them, so the box signs in once with its own state.
        for var in TERM COLORTERM TERM_PROGRAM SHELL LANG LC_ALL LC_CTYPE TZ \
                   SSL_CERT_FILE NIX_SSL_CERT_FILE NIX_REMOTE NIX_PATH NIX_CONFIG \
                   ANTHROPIC_BASE_URL ANTHROPIC_MODEL \
                   CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX
        do
            [[ -n "${!var:-}" ]] && printf 'internal_env+=(%q)\n' "$var=${!var}"
        done
        # The bind lists, classified here while they are all reachable. The
        # shares must stay in the order agent-box-mount is given them.
        for pathspec in "${extra_rw[@]}"; do printf 'extra_rw+=(%q)\n' "$pathspec"; done
        for pathspec in "${extra_ro[@]}"; do printf 'extra_ro+=(%q)\n' "$pathspec"; done
        for pathspec in "${binds[@]}"; do printf 'binds+=(%q)\n' "$pathspec"; done
        for pathspec in "${shares[@]}"; do printf 'shares+=(%q)\n' "$pathspec"; done
    } > "$handoff"

    for var in ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN "${extra_env[@]}"; do
        [[ -n "${!var:-}" ]] \
            && note "$var is not carried across the switch to the box user; the box uses its own login"
    done

    sudo_cmd=(sudo -- "$mount_helper" "${shares[@]}" --
              "$self" --internal-switched
              --internal-user "$(id -un)"
              --internal-home "$HOME"
              --internal-handoff "$handoff"
              "${orig_args[@]}")

    note "Switching to box user"
    { printf 'agent-box: +'; printf ' %q' "${sudo_cmd[@]}"; printf '\n'; } >&2

    # A dry run stops at the switch rather than asking for a password: the line
    # just printed is runnable as it stands, and running it is what shows the
    # bwrap command from the other side — so the handoff has to survive.
    if [[ $dry_run -eq 1 ]]; then
        trap - EXIT INT TERM
        note "handoff kept for that command: $handoff"
        exit 0
    fi

    # Not exec: the handoff is this process's to clean up afterwards.
    rc=0
    "${sudo_cmd[@]}" || rc=$?
    exit $rc
fi

# Phase 2, as the box user, inside agent-box-mount's mount namespace.
resolve_sources
check_access

# ------------------------------------------------------- nix path discovery --

nix_args=()

[[ -d /nix/store ]] || die "/nix/store not found — is this a Nix system?"
nix_args+=(--ro-bind /nix/store /nix/store)

# Builds are done by the daemon, which runs as root outside the sandbox, so
# passing them through is a matter of reaching its socket — the store itself
# stays read-only and every write to it remains the daemon's to make. /nix/var
# is bound read-only for the client's sake: NIX_PATH channels live under
# /nix/var/nix/profiles, and the daemon socket is re-bound read-write on top.
# The connection is untrusted because of the uid we run as, not because of how
# the socket is bound: a read-only bind mount does not stop connect(), since the
# EROFS check exempts sockets.
#
# --offline turns this off. The daemon fetches on the sandbox's behalf, so
# leaving it connected would make that flag a lie.
[[ $offline -eq 1 ]] && nix_daemon=0

if [[ $nix_daemon -eq 1 && -S /nix/var/nix/daemon-socket/socket ]]; then
    nix_ok=1
    nix_args+=(--ro-bind /nix/var /nix/var)
    nix_args+=(--bind /nix/var/nix/daemon-socket /nix/var/nix/daemon-socket)
    [[ -w /nix/var/nix/daemon-socket/socket ]] \
        || note "the Nix daemon socket is not writable by $(id -un); nix will not work inside"
fi

# NixOS runtime paths. Use -try so this also works on plain-Nix hosts.
for p in /run/current-system /run/wrappers /run/opengl-driver /run/opengl-driver-32; do
    [[ -e "$p" ]] && nix_args+=(--ro-bind-try "$p" "$p")
done

# The toolchain lives behind symlink chains such as ~/.nix-profile, which the
# tmpfs $HOME would erase. Resolve each to its store path and recreate the link
# so $PATH keeps resolving, without binding any real $HOME content. These are
# collected separately because they must be applied *after* the tmpfs.
profile_args=()
profile_links=()
if [[ ${#internal_profiles[@]} -gt 0 ]]; then
    # Already resolved as the invoking user, before the switch.
    profile_links=("${internal_profiles[@]}")
else
    for link in \
        "$HOME/.nix-profile" \
        "$HOME/.local/state/nix/profile" \
        "$HOME/.local/state/nix/profiles/profile" \
        /nix/var/nix/profiles/default
    do
        [[ -e "$link" ]] || continue
        target="$(readlink -f -- "$link" 2>/dev/null)" || continue
        case "$target" in
            /nix/store/*) profile_links+=("$link" "$target") ;;
        esac
    done
fi
while [[ ${#profile_links[@]} -gt 0 ]]; do
    link="${profile_links[0]}"
    target="${profile_links[1]}"
    profile_links=("${profile_links[@]:2}")
    # Already present via the read-only /nix/var bind; --symlink over it would
    # abort with EEXIST.
    [[ $nix_ok -eq 1 && "$link" == /nix/var/* ]] && continue
    profile_args+=(--symlink "$target" "$link")
done
# /etc/profiles/per-user/$USER needs no handling: it already resolves through
# the read-only /etc bind, and creating a symlink inside it would fail.

# /etc is needed for /etc/static (NixOS indirection), SSL certs, nsswitch and
# DNS. Root-owned secrets (shadow, host keys) stay unreadable: we are an
# unprivileged uid with all capabilities dropped.
nix_args+=(--ro-bind /etc /etc)

# ------------------------------------------------------ isolated claude state --

state_args=()

# Paths come from the bind list rather than from probing the host: the box user
# cannot see the real ones, only their idmapped copies.
has_bind() {
    local i
    for ((i = 1; i < ${#binds[@]}; i += 2)); do
        [[ "${binds[i]}" == "$1" ]] && return 0
    done
    return 1
}

if [[ $share_claude -eq 1 ]]; then
    state_args+=(--bind "$(src_of "$HOME/.claude")" "$HOME/.claude")
    has_bind "$HOME/.claude.json" \
        && state_args+=(--bind "$(src_of "$HOME/.claude.json")" "$HOME/.claude.json")
else
    state_src="$(src_of "$state_root")"
    state_args+=(--bind "$state_src/claude" "$HOME/.claude")
    state_args+=(--bind "$state_src/claude.json" "$HOME/.claude.json")

    # Share only the credentials file, read-write. Copying it instead would let
    # the sandbox rotate the OAuth refresh token and silently invalidate the
    # host's login; a shared bind of this one file keeps them in sync.
    creds="$HOME/.claude/.credentials.json"
    has_bind "$creds" && state_args+=(--bind "$(src_of "$creds")" "$creds")
fi

for p in "${extra_rw[@]}"; do extra_binds+=(--bind "$(src_of "$p")" "$p"); done
for p in "${extra_ro[@]}"; do extra_binds+=(--ro-bind "$(src_of "$p")" "$p"); done

# Resume the last conversation by default. `claude --continue` exits with an
# error when there is nothing to resume, so only add it once this project has a
# transcript. Claude keys transcripts by the project path with every
# non-alphanumeric character replaced by '-'.
if [[ $default_cmd -eq 1 && $new_session -eq 0 ]]; then
    if [[ $share_claude -eq 1 ]]; then
        claude_dir="$(src_of "$HOME/.claude")"
    else
        claude_dir="$(src_of "$state_root")/claude"
    fi
    transcripts="$claude_dir/projects/${project//[^a-zA-Z0-9]/-}"
    # Not compgen: the minimal bash a Nix shebang resolves to is built
    # without programmable completion. With nullglob off an unmatched glob
    # stays literal, and -e on that literal is false.
    transcript_files=("$transcripts"/*.jsonl)
    if [[ -e ${transcript_files[0]} ]]; then
        cmd+=(--continue)
    fi
fi

# Tell the default claude where it is. Without this it reads a missing tool, an
# empty $HOME or an unreachable path as a fact about the project or the user's
# machine, and either reports it as such or tries to "fix" it. Not persisted:
# the system prompt is rebuilt on every launch, --continue included.
if [[ $default_cmd -eq 1 ]]; then
    cmd+=(--append-system-prompt "You are running inside a restricted \
sandbox. Do not make assumptions about the project based on the environment. \
Do not try to work around the sandbox, instead, ask the user")
fi

# -------------------------------------------------------------- environment --

# The host's $PATH, which on the far side of the switch arrives in argv: sudo
# resets the environment, and the invoking user's profile entries are exactly
# what the sandbox needs to keep.
host_path="${internal_path:-$PATH}"

# Drop $PATH entries under $HOME that will not exist inside the sandbox,
# keeping the Nix profile paths we recreated as symlinks above.
sandbox_path=""
while IFS= read -r entry; do
    [[ -z "$entry" ]] && continue
    case "$entry" in
        "$HOME"/.nix-profile/*|"$HOME"/.local/state/nix/profile/*) ;;
        "$HOME"/*) continue ;;
    esac
    sandbox_path="${sandbox_path:+$sandbox_path:}$entry"
done < <(printf '%s' "$host_path" | tr ':' '\n')

# The sandbox PATH is the host's minus the $HOME entries, so a command can be
# resolvable out here and missing in there. Say so plainly instead of letting
# bwrap fail with a bare execvp error.
if [[ ${cmd[0]} != */* ]]; then
    ( PATH="$sandbox_path"; hash -r; command -v -- "${cmd[0]}" ) >/dev/null 2>&1 \
        || die "command not found on the sandbox PATH: ${cmd[0]}"
fi

# The identity inside is the uid we actually run as, not the invoking user's:
# $USER disagreeing with `id -un` confuses everything from git to npm.
box_user_name="$(id -un)"

env_args=(--clearenv)
env_args+=(--setenv HOME "$HOME")
env_args+=(--setenv USER "$box_user_name")
env_args+=(--setenv LOGNAME "$box_user_name")
env_args+=(--setenv PATH "$sandbox_path")
env_args+=(--setenv PWD "$project")

# Idmapped, the project reads as the box user's own. This still matters for a
# project you do not own, which is bound as is: git refuses that as "dubious
# ownership" unless the path is allowed.
env_args+=(--setenv GIT_CONFIG_COUNT 1)
env_args+=(--setenv GIT_CONFIG_KEY_0 safe.directory)
env_args+=(--setenv GIT_CONFIG_VALUE_0 "$project")

# NIX_PATH is what makes <nixpkgs> resolve; it points into /nix/var/nix/profiles,
# which is bound above. Only pass them when the daemon actually came through.
nix_env=()
[[ $nix_ok -eq 1 ]] && nix_env=(NIX_REMOTE NIX_PATH)

# Pass through only benign locale/terminal settings plus Anthropic config, so
# unrelated secrets in the parent shell (AWS_*, GITHUB_TOKEN, ...) stay out.
for var in SHELL TERM COLORTERM TERM_PROGRAM LANG LC_ALL LC_CTYPE TZ \
           SSL_CERT_FILE NIX_SSL_CERT_FILE "${nix_env[@]}" \
           ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL \
           ANTHROPIC_MODEL CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX \
           "${extra_env[@]}"
do
    [[ -n "${!var:-}" ]] && env_args+=(--setenv "$var" "${!var}")
done

# ~/.config/nix/nix.conf is deliberately not bound: it routinely carries
# access-tokens. Its other settings still matter — experimental-features being
# the one that decides whether `nix build` runs at all — so the file is passed
# through as NIX_CONFIG with the secret-bearing settings filtered out. Across
# the switch it arrives pre-scrubbed in NIX_CONFIG, since the box user cannot
# read ~/.config in the first place.
if [[ $nix_ok -eq 1 ]]; then
    nix_config="${NIX_CONFIG:-}"
    if [[ $internal_switched -eq 0 && -r "$HOME/.config/nix/nix.conf" ]]; then
        scrubbed="$(grep -Ev \
            '^[[:space:]]*(extra-)?(access-tokens|netrc-file|secret-key-files)[[:space:]]*=' \
            "$HOME/.config/nix/nix.conf" || true)"
        if [[ -n "$nix_config" ]]; then
            nix_config="$(printf '%s\n%s' "$nix_config" "$scrubbed")"
        else
            nix_config="$scrubbed"
        fi
    fi
    [[ -n "${nix_config//[[:space:]]/}" ]] \
        && env_args+=(--setenv NIX_CONFIG "$nix_config")
fi

# ----------------------------------------------------------- sandbox launch --

# The whole reason for the user switch, so verify it rather than assume it: the
# daemon reports whether it trusts this connection. Best-effort — an old nix, or
# one without the nix-command feature, simply does not answer.
if [[ $nix_ok -eq 1 ]] && command -v nix >/dev/null 2>&1; then
    trusted="$(nix store info --json --extra-experimental-features nix-command \
                 2>/dev/null | tr -d '[:space:]' | grep -o '"trusted":[a-z0-9]*' || true)"
    case "$trusted" in
        '"trusted":true'|'"trusted":1')
            die "the Nix daemon still trusts this uid ($box_user_name): it is listed in trusted-users (nix.conf), so the sandbox would be able to set build-hook and friends. Set a different box_user in agent-box-mount." ;;
    esac
fi

bwrap_args=(
    "${nix_args[@]}"
    --proc /proc
    --dev /dev
    --tmpfs "$HOME"          # must precede binds under $HOME or it wipes them
    "${profile_args[@]}"     # ...so the profile symlinks are recreated here
    --tmpfs /tmp
    --tmpfs /var/tmp
    "$project_mode" "$(src_of "$project")" "$project"
    "${state_args[@]}"
    "${extra_binds[@]}"
    --unshare-pid
    --unshare-ipc
    --unshare-uts
    --unshare-cgroup
    --hostname agent-box
    --cap-drop ALL
    --die-with-parent
    --chdir "$project"
    "${env_args[@]}"
)

# Note: --unshare-user is deliberately omitted. bwrap already creates a user
# namespace, and forcing another breaks the nested bwrap that Claude Code's own
# Bash sandbox relies on. --new-session is likewise omitted: it would cost the
# controlling TTY the interactive UI needs, and dev.tty.legacy_tiocsti is 0 on
# modern kernels, so TIOCSTI injection is already blocked.
[[ $offline -eq 1 ]] && bwrap_args+=(--unshare-net)

if [[ $dry_run -eq 1 ]]; then
    printf 'bwrap'
    printf ' %q' "${bwrap_args[@]}" -- "${cmd[@]}"
    printf '\n'
    exit 0
fi

exec bwrap "${bwrap_args[@]}" -- "${cmd[@]}"
